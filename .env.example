# Backend settings. Replace all placeholder credentials before deployment.
PROJECT_NAME="Nimmana Pavani Portfolio & Career CMS API"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-random-secret-before-deployment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./portfolio.db"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_CORS_ORIGIN_REGEX="^https://.*\\.(netlify|vercel)\\.app$"
UPLOAD_DIR="./uploads"
STORAGE_TYPE="local"
ADMIN_EMAIL="your-email@example.com"
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password"
# Set privately for the backend only; never use a NEXT_PUBLIC_ variable.
ADMIN_NAME=""

# Frontend setting
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
